# Backend environment variables (Render / Docker / local)
# Copy to ../../.env for local monorepo dev, or set in your host platform.

NODE_ENV=development
PORT=4000

# Public URL of this API (no trailing slash). On Render, omit to auto-use RENDER_EXTERNAL_URL.
APP_URL=http://localhost:4000

# Public URL of the Next.js frontend (no trailing slash). Required in production.
# Bare hostnames work too (https:// is added automatically): my-app.vercel.app
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection string.
# Neon example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://cds:cds_password@localhost:5432/cds?schema=public

# JWT signing secrets — use long random strings in production (openssl rand -hex 64)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# HMAC secret for signed watch/stream tokens (falls back to JWT_REFRESH_SECRET on Render if unset)
LINK_SIGNING_SECRET=

# Cross-origin cookies (Vercel frontend + Render backend): leave COOKIE_DOMAIN empty, set COOKIE_SECURE=true
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Google OAuth (user login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — defaults to ${APP_URL}/api/v1/auth/google/callback when empty
GOOGLE_OAUTH_REDIRECT_URI=

# Google Drive (content storage) — service account OR OAuth refresh token
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# SMTP (notification emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Content Delivery System <no-reply@example.com>"
ALERT_DEFAULT_RECIPIENT=

# Extra CORS origins (comma-separated). FRONTEND_URL is always allowed.
CORS_ORIGINS=http://localhost:3000

# First account with this email gets SUPER_ADMIN on signup/OAuth
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
