# ==========================================================================
# Content Delivery System - Environment Configuration (monorepo root)
# Copy to `.env` for local development. See also:
#   backend/.env.example  — backend-only variables
#   frontend/.env.example — frontend-only variables
# ==========================================================================

# --- General ---
NODE_ENV=development
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
PORT=4000

# --- Database (PostgreSQL) ---
# Local docker-compose uses host `db`. Neon production example:
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
POSTGRES_USER=cds
POSTGRES_PASSWORD=cds_password
POSTGRES_DB=cds
DATABASE_URL=postgresql://cds:cds_password@localhost:5432/cds?schema=public

# --- JWT / Auth ---
JWT_ACCESS_SECRET=change_me_access_secret_please
JWT_REFRESH_SECRET=change_me_refresh_secret_please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
LINK_SIGNING_SECRET=change_me_link_signing_secret

# --- Cookies ---
# Production (Vercel + Render): COOKIE_SECURE=true, COOKIE_DOMAIN= (empty)
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- Google OAuth (login) ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Optional — defaults to ${APP_URL}/api/v1/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# --- Google Drive ---
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Content Delivery System <notifications@example.com>"
ALERT_DEFAULT_RECIPIENT=admin@example.com

# --- Security ---
# FRONTEND_URL is always allowed; list any extra origins here (comma-separated)
CORS_ORIGINS=http://localhost:3000
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com

# --- Frontend (Next.js / Vercel) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
